[GameServerInfo]
;==================================================
; AntiFlood Settings
; Recommended configuration
; Don't change without knowledge
;==================================================
AntiFloodActive = 1
AntiFloodResetTime = 1000
AntiFloodMaxCount = 3
AntiFloodCheckTime = 50
AntiFloodBlocTime = 60

;==================================================
; Hack Settings
;==================================================
CheckSpeedHack = 1
CheckSpeedHackTolerance = 300
CheckLatencyHack = 1
CheckLatencyHackTolerance = 4000
CheckAutoPotionHack = 1
CheckAutoPotionHackTolerance = 400
CheckAutoComboHack = 1
CheckAutoComboHackTolerance = 850
CheckHackPacketSerial = 1

;==================================================
; Hack Speed Skill Settings (HackSkillCheck.txt)
; Types:
; 0: Show message in log only
; 1: Disconnect User
; 2: Disable Attack
; 3: Disable attack by x miliseconds
; 4: Disconnect User & bloc account
; 5: Ignore over hits
;==================================================
SpeedHackSkillEnable = 1
SpeedHackSkillType = 5
SpeedHackSkillPenalty = 5000
SpeedHackSkillDialog = 1
SpeedHackSkillMaxOverHits = 10
SpeedHackSkillMaxOverHitsType = 2

;==================================================
; Hack Movement Settings
; Types:
; 0: Show message in log only
; 1: Disconnect User
; 2: Disconnect User & bloc account
; 3: Order of Restraint Buff
;==================================================
SpeedHackMovementEnable = 1
SpeedHackMovementType = 3
SpeedHackMovementDistanceNormal = 2
SpeedHackMovementDistanceFenrir = 2
SpeedHackMovementDistanceHorse = 2
SpeedHackMovementDistanceWing = 2
SpeedHackMovementMaxBlockDays = 30
SpeedHackMovementTolerance = 3
SpeedHackMovementToleranceTime = 4000
SpeedHackMovementBuffTime = 10

;==================================================
; Hack Skill double Settings
;==================================================
CheckHackSkillDoubleEnable = 1

;==================================================
; Hack Dupe auto ban
;==================================================
CheckHackDupeAutoBan = 1
